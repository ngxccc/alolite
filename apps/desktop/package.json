{
  "name": "alolite-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "immer": "^11.2.9",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-config-presets": "^0.1.21",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": ">=6.0.3 <7.0.0",
    "vite": "^8.3.7"
  }
}
